---
/**
 * The Super (BRAND.md §3, §7.3): the site's only headline shape, shared with
 * the release film. Two beats — one light, one bold, in either order — with an
 * optional mono eyebrow above and one quiet line below.
 *
 * Each beat is its own line and rises into place once when the super enters
 * view (`data-reveal`, driven by the page's one observer). The heading reads as
 * one sentence to assistive technology.
 */
interface Beat {
  text: string;
  bold?: boolean;
}

interface Props {
  beats: readonly Beat[];
  eyebrow?: string;
  sub?: string;
  level?: 1 | 2 | 3;
  id?: string;
  size?: "hero" | "chapter" | "small";
  class?: string;
}

const { beats, eyebrow, sub, level = 2, id, size = "chapter", class: className } = Astro.props;
const Heading = `h${level}` as "h1" | "h2" | "h3";
---

<div class:list={["super", `super--${size}`, className]} data-reveal>
  {eyebrow && <p class="super-eyebrow">{eyebrow}</p>}
  <Heading class="super-title" id={id}>
    {
      beats.map((beat, index) => (
        <>
          <span
            class:list={["super-beat", { "super-beat--bold": beat.bold }]}
            style={`--beat: ${index}`}
          >
            <span>{beat.text}</span>
          </span>
          {index < beats.length - 1 ? " " : null}
        </>
      ))
    }
  </Heading>
  {sub && <p class="super-sub">{sub}</p>}
</div>
