---
/**
 * Hero accompaniment: the product's three beats — ticket, chat, review — as a
 * small vertical flow.
 *
 * It sits beside the hero copy where blank space would otherwise be. It is
 * deliberately NOT a screenshot and not a second copy of the demo below: it
 * borrows the app's palette and card grammar to teach the shape of the loop in
 * three glances, at a scale that fits next to a paragraph.
 *
 * Decorative by contract. Everything it says is said in the hero copy, so it is
 * `aria-hidden` and carries no focusable targets.
 */
---

<div class="hero-flow" aria-hidden="true">
  <div class="hero-flow-glow"></div>

  <ol class="hero-flow-track">
    <li class="hf-step" style="--i: 0">
      <span class="hf-eyebrow">Ticket</span>
      <div class="hf-card">
        <div class="hf-card-head">
          <span class="hf-code">HB-32</span>
          <span class="hf-prio"><i></i><i></i><i class="is-off"></i></span>
        </div>
        <strong>Move billing to webhooks</strong>
        <p>Off the nightly job, onto Stripe webhooks.</p>
      </div>
    </li>

    <li class="hf-step" style="--i: 1">
      <span class="hf-eyebrow">Chat</span>
      <div class="hf-card hf-card--chat">
        <div class="hf-card-head">
          <span class="hf-author">Volli</span>
          <span class="hf-chip">Effort: Medium</span>
        </div>
        <p>Ticket body attached. Working in the ticket&rsquo;s worktree.</p>
        <div class="hf-tools">
          <span>Read <small>repo instructions</small></span>
          <span>Edit <small>4 files</small></span>
        </div>
      </div>
    </li>

    <li class="hf-step" style="--i: 2">
      <span class="hf-eyebrow">Review</span>
      <div class="hf-card">
        <span class="hf-branch">volli/hb-32-billing-webhooks</span>
        <div class="hf-diff">
          <span class="hf-add">+128</span>
          <span class="hf-del">&minus;34</span>
          <span class="hf-files">4 files changed</span>
        </div>
      </div>
    </li>
  </ol>
</div>

<style>
  .hero-flow {
    position: relative;
    width: 100%;
    max-width: 430px;
    padding: 8px 0;
    isolation: isolate;
  }

  /* Ember light behind the flow, echoing the demo's sunset mesh without
     repeating its full treatment. */
  .hero-flow-glow {
    position: absolute;
    z-index: -1;
    top: 50%;
    left: 50%;
    width: 132%;
    height: 116%;
    background:
      radial-gradient(58% 44% at 62% 22%, rgb(232 101 42 / 20%), transparent 70%),
      radial-gradient(48% 40% at 28% 82%, rgb(196 78 140 / 12%), transparent 72%);
    filter: blur(14px);
    transform: translate(-50%, -50%);
  }

  .hero-flow-track {
    display: grid;
    position: relative;
    margin: 0;
    padding: 0;
    gap: 14px;
    list-style: none;
  }

  /* The thread the three beats hang from. */
  .hero-flow-track::before {
    position: absolute;
    z-index: 0;
    top: 14px;
    bottom: 14px;
    left: 5px;
    width: 1px;
    background: linear-gradient(
      180deg,
      transparent,
      rgb(232 101 42 / 55%) 12%,
      rgb(232 101 42 / 22%) 62%,
      transparent
    );
    content: "";
  }

  .hf-step {
    display: grid;
    position: relative;
    padding-left: 22px;
    gap: 6px;
    animation: hf-rise 620ms cubic-bezier(0.23, 1, 0.32, 1) backwards;
    animation-delay: calc(var(--i) * 110ms + 120ms);
  }

  /* Node on the thread. */
  .hf-step::before {
    position: absolute;
    top: 4px;
    left: 2px;
    width: 7px;
    height: 7px;
    border: 1px solid rgb(232 101 42 / 70%);
    border-radius: 50%;
    background: #120b08;
    content: "";
  }

  .hf-eyebrow {
    color: #9a7460;
    font-size: 10px;
    font-weight: 640;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .hf-card {
    display: grid;
    padding: 13px 15px;
    gap: 7px;
    border: 1px solid #272727;
    border-radius: 13px;
    background: linear-gradient(168deg, #17161600, #121212);
    background-color: #131313;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 4%) inset,
      0 12px 30px rgb(0 0 0 / 34%);
  }

  .hf-card--chat {
    border-color: #34291f;
    background-color: #161210;
  }

  .hf-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .hf-code {
    color: #7d7d82;
    font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.04em;
  }

  .hf-prio {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
  }

  .hf-prio i {
    width: 3px;
    height: 8px;
    border-radius: 1px;
    background: #e8652a;
  }

  .hf-prio i:first-child {
    height: 5px;
  }

  .hf-prio i.is-off {
    background: #333;
  }

  .hf-card strong {
    color: #ededef;
    font-size: 14px;
    font-weight: 560;
    letter-spacing: -0.02em;
  }

  .hf-card p {
    margin: 0;
    color: #93939a;
    font-size: 12px;
    font-weight: 380;
    line-height: 1.5;
  }

  .hf-author {
    color: #d08557;
    font-size: 10px;
    font-weight: 660;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hf-chip {
    padding: 3px 8px;
    border: 1px solid #302f2f;
    border-radius: 999px;
    color: #96969b;
    font-size: 10px;
    font-weight: 540;
    white-space: nowrap;
  }

  .hf-tools {
    display: grid;
    margin-top: 1px;
    gap: 5px;
  }

  .hf-tools span {
    padding: 6px 9px;
    border: 1px solid #242424;
    border-radius: 7px;
    background: #101010;
    color: #c4c4c8;
    font-size: 11px;
    font-weight: 540;
  }

  .hf-tools small {
    margin-left: 5px;
    color: #77777c;
    font-size: 10px;
    font-weight: 400;
  }

  .hf-branch {
    color: #9d9da2;
    font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hf-diff {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
    font-size: 11px;
  }

  .hf-add {
    color: #7fb98f;
  }

  .hf-del {
    color: #c97a72;
  }

  .hf-files {
    color: #77777c;
    font-family: "Mona Sans Variable", "Mona Sans", ui-sans-serif, sans-serif;
    font-size: 11px;
  }

  @keyframes hf-rise {
    from {
      opacity: 0;
      transform: translateY(9px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hf-step {
      animation: none;
    }
  }
</style>
