---
import {
  PREVIEW_AGREEMENT_URL,
  PREVIEW_AGREEMENT_VERSION,
  PREVIEW_AGREEMENT_UPDATED_AT,
  PREVIEW_PRIVACY_URL,
} from "@volli/shared";
import Base from "./Base.astro";

interface Props {
  title: string;
  description: string;
  path: string;
}

const { title, description, path } = Astro.props;
const updatedLabel = new Date(PREVIEW_AGREEMENT_UPDATED_AT).toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
---

<Base title={`${title} — Volli`} description={description} path={path}>
  <main id="main" class="legal page" tabindex="-1">
    <article aria-labelledby="legal-title">
      <h1 id="legal-title">{title}</h1>
      <p class="legal-version">
        Version {PREVIEW_AGREEMENT_VERSION} · Updated <time datetime={PREVIEW_AGREEMENT_UPDATED_AT}>{updatedLabel}</time>
      </p>
      <nav aria-label="Preview legal pages">
        <a
          href={PREVIEW_AGREEMENT_URL}
          aria-current={path === "/legal/preview/" ? "page" : undefined}
        >Preview Agreement</a>
        <a
          href={PREVIEW_PRIVACY_URL}
          aria-current={path === "/legal/privacy/" ? "page" : undefined}
        >Privacy</a>
        <a
          href="/legal/subprocessors/"
          aria-current={path === "/legal/subprocessors/" ? "page" : undefined}
        >Subprocessors</a>
      </nav>
      <slot />
    </article>
  </main>
</Base>

<style>
  .legal {
    max-width: 42rem;
    padding-block: clamp(40px, 8vw, 96px);
    line-height: 1.7;
  }

  .legal h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .legal-version,
  .legal nav {
    margin-top: 1rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .legal nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-bottom: 2.5rem;
  }

  .legal :global(h2) {
    margin-block: 2rem 0.75rem;
    font-size: 1.25rem;
    line-height: 1.4;
  }

  .legal :global(p + p),
  .legal :global(ul) {
    margin-top: 1rem;
  }

  .legal :global(li + li) {
    margin-top: 0.75rem;
  }

  .legal :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .legal :global(a:hover),
  .legal a[aria-current="page"] {
    color: var(--ink);
  }
</style>
