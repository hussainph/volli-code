---
/**
 * PROPOSAL — a 0.2 homepage for comparative review, not the live lander.
 *
 * `/` is untouched; this route is excluded from the sitemap (astro.config.mjs)
 * and carries noindex, so it can be deployed beside the current page and
 * compared without being found.
 *
 * Shape: the whole product first, the release second.
 *  - hero → the interactive board demo (the same VolliDemo island as `/`) →
 *    what the workspace is made of → New in 0.2: Automations → trust → closing;
 *  - Automations is one section, not three: the storyboard (audit §6.3) and
 *    three ways to start, with the control facts (§1.4) folded into the cards;
 *  - copy stays inside the audit's §9.2 safe-claims list and the app's own
 *    labels (§8.4); local-first, provider and open-source posture are said in
 *    one place (§3.5).
 */
import "@fontsource-variable/mona-sans/wght.css";
import AutomationStoryboard from "../../components/AutomationStoryboard.astro";
import FeatureGlyph from "../../components/FeatureGlyph.astro";
import VolliDemo from "../../components/VolliDemo";
import "../../styles/global.css";
import "../../styles/home-0-2.css";

const repositoryUrl = "https://github.com/hussainph/volli-code";
const releasesUrl = `${repositoryUrl}/releases`;
const issuesUrl = `${repositoryUrl}/issues`;
const docsUrl = "https://docs.volli.app";
// The launch build should point this at the Automations guide once
// docs/guides/automations ships (audit §8.1). Until then the docs home is the
// only destination that exists, and a reviewer should not land on a 404.
const automationsDocsUrl = docsUrl;
const description =
  "Plan coding work. Run it in parallel. Automate the repeatable parts. Volli is a local-first macOS workspace for people and coding agents.";

// What the workspace is made of. Items 1, 2, 5 and 6 carry the live page's
// vetted claims (LifecycleAccordion); 3 and 4 add the agent's tool surface,
// Skills, the `volli` CLI and the Change Set review, all as CONTEXT.md
// defines them.
const workspace = [
  {
    title: "Turn ideas into tasks",
    description:
      "Start with a rough goal. Create focused tasks yourself, or ask an agent to help break the work down.",
    glyph: "phases" as const,
  },
  {
    title: "Run agents in parallel",
    description:
      "Each ticket gets its own worktree and branch. Run independent tickets in parallel without touching the main checkout.",
    glyph: "parallel" as const,
  },
  {
    title: "Give agents the tools they need",
    description:
      "An agent can read, edit, and run commands in its worktree. It can use its tools and the volli CLI to read the board, comment, and move tickets.",
    glyph: "agents" as const,
  },
  {
    title: "Review every change",
    description:
      "Inspect a ticket’s changes against its base branch, read the files, and decide when the work is ready to move forward.",
    glyph: "review" as const,
  },
  {
    title: "Come back any time",
    description:
      "Leave, restart Volli, and come back to the same chat with its history intact.",
    glyph: "context" as const,
  },
  {
    title: "Keep your TUI workflow",
    description:
      "Open Claude Code, Codex, OpenCode, or your own TUI in an embedded terminal in the same worktree whenever you want to drive it yourself.",
    glyph: "harnesses" as const,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {/* A proposal page for comparison, not a public route: keep it out of
        search and out of the sitemap (see astro.config.mjs). */}
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Volli | Plan coding work. Run it in parallel. Automate the repeatable parts." />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://volli.app/og.png" />
    <meta property="og:site_name" content="Volli" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/png" href="/volli-icon-dark.png" />
    <title>Volli | Plan coding work. Run it in parallel. Automate the repeatable parts.</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    {/* Reviewer context only. Delete this bar if the proposal is adopted. */}
    <p class="proposal-note">
      <span>Proposal</span>
      A 0.2 homepage for side-by-side review. The live page is unchanged.
      <a href="/">Open the current homepage</a>
    </p>

    <header class="site-header">
      <a class="footer-brand site-brand" href="#top" aria-label="Volli home">
        <img src="/volli-icon-dark.png" alt="" width="34" height="34" />
        <span>Volli</span>
      </a>
      <nav aria-label="Primary">
        <a href="#product">Product</a>
        <a href="#automations">Automations</a>
        <a href={docsUrl}>Docs</a>
        <a href={repositoryUrl}>GitHub</a>
        <a class="site-nav-cta" href="/download/">Download</a>
      </nav>
    </header>

    {/* tabindex so the skip link moves focus in Safari, not just the viewport. */}
    <main id="main" tabindex="-1">
      {/* The durable promise. Category, maturity and platform are read before
          anything else on the page. */}
      <section class="hero hero--proposal" id="top">
        <span class="alpha-pill">Alpha · Apple silicon</span>
        {/* Each clause is masked so it can rise into place once on load; the
            text stays one node per clause and reads as one sentence. */}
        <h1 class="hero-headline hero-headline--proposal">
          <span class="hero-clause"><span>Plan coding work.</span></span>{" "}
          <span class="hero-clause"><span>Run it in parallel.</span></span>{" "}
          <span class="hero-clause"><span>Automate the repeatable parts.</span></span>
        </h1>
        <p class="hero-lede">
          Volli is a local-first macOS workspace. Plan coding work as tickets on a board, then run
          coding agents in separate worktrees. Review each change. In 0.2, save repeated setup as an
          Automation.
        </p>

        <div class="cta-row hero-cta">
          <a class="cta cta-primary" href="/download/">
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 2.6c.5 0 .9.4.9.9v8.9l3.2-3.2a.9.9 0 1 1 1.3 1.3l-4.8 4.7a.9.9 0 0 1-1.2 0L6.6 10.5a.9.9 0 1 1 1.3-1.3l3.2 3.2V3.5c0-.5.4-.9.9-.9Zm-7.5 14a.9.9 0 0 1 .9.9v1.6c0 .5.4.9.9.9h11.4c.5 0 .9-.4.9-.9v-1.6a.9.9 0 1 1 1.8 0v1.6a2.7 2.7 0 0 1-2.7 2.7H6.3a2.7 2.7 0 0 1-2.7-2.7v-1.6c0-.5.4-.9.9-.9Z"
              />
            </svg>
            <span>Download for Apple silicon</span>
          </a>
          <a class="cta cta-secondary" href="#automations">
            <svg viewBox="0 0 256 256" width="17" height="17" aria-hidden="true">
              <path
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="20"
                d="M96 240l16-80-64-24L160 16l-16 80 64 24z"
              />
            </svg>
            <span>See what’s new in 0.2</span>
          </a>
        </div>

        <p class="hero-alpha-note">
          <span class="hero-category">The workspace for parallel coding agents</span>
          <a href={`${docsUrl}/start/quickstart/`}>Quickstart</a>
          <a href={`${docsUrl}/start/install/`}>Install guide</a>
          <a href={releasesUrl}>Release notes</a>
        </p>
      </section>

      {/* The product proof: the same interactive board as the live page. Drag
          a ticket and a Session opens — the loop everything else builds on. */}
      <section class="hero-shell" aria-label="Volli product preview">
        <VolliDemo client:load />
      </section>

      {/* What the workspace is made of. The board and the worktrees are the
          product; Automations, below, are one way to start it. */}
      <section class="workspace" id="product" aria-labelledby="workspace-title">
        <div class="section-head">
          <h2 id="workspace-title">One board. A worktree per ticket. You decide what moves.</h2>
          <p>
            Each ticket has a brief, a chat you can come back to, and changes to review. The board
            keeps work visible as you move it.
          </p>
        </div>
        <ol class="workspace-grid">
          {
            workspace.map((item, index) => (
              <li class="workspace-item">
                <FeatureGlyph kind={item.glyph} />
                <span class="workspace-index">0{index + 1}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </li>
            ))
          }
        </ol>
      </section>

      {/* New in 0.2. The version lives here and nowhere else, so the product
          does not read as a scheduler once 0.3 ships. One section: the
          storyboard (§6.3), the three ways a Run starts (§7.1 step 5), and the
          control facts (§1.4) folded into the cards rather than listed twice. */}
      <section class="release" id="automations" aria-labelledby="release-title">
        <div class="release-band" data-release-band>
          <span class="release-version">
            <svg viewBox="0 0 256 256" width="14" height="14" aria-hidden="true">
              <path
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="22"
                d="M96 240l16-80-64-24L160 16l-16 80 64 24z"
              />
            </svg>
            New in Volli 0.2
          </span>
          <h2 class="release-title" id="release-title">Save how work starts.</h2>
          <p class="release-lede">
            An Automation saves the instructions, trigger, and runtime for repeated work. Run it by
            hand, arm a board column, or put it on a schedule. Each run opens a fresh Session.
          </p>
        </div>

        <AutomationStoryboard />

        <div class="release-ways">
          <h3 class="release-subhead">Three ways to start the same work</h3>
          <div class="ways-grid">
            <article class="way" data-spotlight>
              <span class="way-index">By hand</span>
              <h4>Run it when you want</h4>
              <p>
                From the Automations page, a ticket rail, a board card, or the command palette.
                Running by hand doesn’t depend on the trigger. Need it once?{" "}
                <strong>Run once</strong> makes an Unbound Run: one-time Instructions, nothing saved.
              </p>
            </article>
            <article class="way" data-spotlight>
              <span class="way-index">Ticket enters</span>
              <h4>When a ticket lands in a column</h4>
              <p>
                Switch it to Enabled on this Mac and its trigger counts. Name columns in the trigger
                and arm one automation per column. Only a deliberate move — a drag,
                status change, or volli CLI move — fires it. Tickets already there and lifecycle moves
                don’t start a run.
              </p>
            </article>
            <article class="way" data-spotlight>
              <span class="way-index">On a schedule</span>
              <h4>Hourly, Every day, Mon–Fri, or Weekly</h4>
              <p>
                In the time zone you choose. Each occurrence opens a Session for the project only
                while Volli is open. Scheduled skips record why they didn’t start. <strong>Run
                now</strong> starts one by hand; skipped occurrences never replay themselves.
              </p>
            </article>
          </div>
          <p class="release-closer">
            Automations remove repetitive setup, not the person. Automatic triggering is local to
            this Mac. Every run starts a fresh Session, and the history shows what happened.
          </p>
        </div>
      </section>

      {/* One place for the trust facts the download page and the docs
          currently split between them (§3.5). */}
      <section class="trust" aria-labelledby="trust-title">
        <div class="section-head">
          <h2 id="trust-title">Local-first, by construction</h2>
        </div>
        <div class="trust-grid">
          <article class="trust-item">
            <h3>Your work stays on your Mac</h3>
            <p>
              Projects, tickets, chats, and automations — including their switches on this Mac — live
              in local storage. Each ticket’s worktree is an ordinary Git checkout on your disk. Volli
              itself needs no account.
            </p>
          </article>
          <article class="trust-item">
            <h3>Your models, your provider</h3>
            <p>
              Model requests go to the provider and account you configure in{" "}
              <a href={`${docsUrl}/guides/settings/`}>Model Access</a>. An automation’s runtime sets
              its model and tier. Choose Deep, Fast, or Default model.
            </p>
          </article>
          <article class="trust-item">
            <h3>Open source, Apache-2.0</h3>
            <p>
              Read the source or report a problem. The alpha is available from{" "}
              <a href={releasesUrl}>GitHub Releases</a> for Apple silicon Macs.
            </p>
          </article>
        </div>
      </section>

      {/* The closing routes. */}
      <section class="closing" aria-labelledby="closing-title">
        <h2 id="closing-title">Try the 0.2 alpha</h2>
        <p>
          For Apple silicon Macs running macOS 12 or later. This is an alpha; report problems you
          find.
        </p>
        <div class="cta-row closing-cta">
          <a class="cta cta-primary" href="/download/">
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 2.6c.5 0 .9.4.9.9v8.9l3.2-3.2a.9.9 0 1 1 1.3 1.3l-4.8 4.7a.9.9 0 0 1-1.2 0L6.6 10.5a.9.9 0 1 1 1.3-1.3l3.2 3.2V3.5c0-.5.4-.9.9-.9Zm-7.5 14a.9.9 0 0 1 .9.9v1.6c0 .5.4.9.9.9h11.4c.5 0 .9-.4.9-.9v-1.6a.9.9 0 1 1 1.8 0v1.6a2.7 2.7 0 0 1-2.7 2.7H6.3a2.7 2.7 0 0 1-2.7-2.7v-1.6c0-.5.4-.9.9-.9Z"
              />
            </svg>
            <span>Download for Apple silicon</span>
          </a>
          <a class="cta cta-secondary" href={automationsDocsUrl}>
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
              <path
                fill="currentColor"
                d="M4 4.6c0-.6.5-1.1 1.1-1.1h4.3c1.1 0 2.1.5 2.6 1.4.6-.9 1.5-1.4 2.6-1.4h4.3c.6 0 1.1.5 1.1 1.1v13c0 .6-.5 1.1-1.1 1.1h-4.3c-.9 0-1.7.4-2.2 1.1a.9.9 0 0 1-1.5 0 2.6 2.6 0 0 0-2.2-1.1H5.1c-.6 0-1.1-.5-1.1-1.1v-13Zm7.1 12.2V6.6c0-.7-.6-1.3-1.3-1.3H5.8v11h3.6c.6 0 1.2.2 1.7.5Zm1.8 0c.5-.3 1.1-.5 1.7-.5h3.6v-11h-4c-.7 0-1.3.6-1.3 1.3v10.2Z"
              />
            </svg>
            <span>Read the docs</span>
          </a>
          <a class="cta cta-secondary" href={repositoryUrl}>
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.74-1.55-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.79 1.07.79 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"
              />
            </svg>
            <span>View source</span>
          </a>
        </div>
        <p class="closing-note">
          <a href={issuesUrl}>Report a problem</a>
          <a href={`${repositoryUrl}/security/policy`}>Security</a>
        </p>
      </section>
    </main>

    <footer>
      <a class="footer-brand" href="#top" aria-label="Volli home">
        <img src="/volli-icon-dark.png" alt="" width="34" height="34" />
        <span>Volli</span>
      </a>
      <nav aria-label="Footer">
        <a href="/download/">Download</a>
        <a href="#product">Product</a>
        <a href="#automations">Automations</a>
        <a href={docsUrl}>Docs</a>
        <a href={`${docsUrl}/start/quickstart/`}>Quickstart</a>
        <a href={repositoryUrl}>GitHub</a>
        <a href={releasesUrl}>Releases</a>
        <a href={`${repositoryUrl}/security/policy`}>Security</a>
        <a href={issuesUrl}>Feedback</a>
      </nav>
    </footer>

    <script>
      // Two decorations, neither load-bearing. The beam runs once when the
      // release band is on screen; the spotlight follows a fine pointer over
      // the three cards. Both stay off under prefers-reduced-motion, and the
      // page reads the same without them.
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const band = document.querySelector<HTMLElement>("[data-release-band]");
      if (band && !reducedMotion && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;
            band.classList.add("is-live");
            observer.disconnect();
          },
          { threshold: 0.6 },
        );
        observer.observe(band);
      }

      if (!reducedMotion && window.matchMedia("(pointer: fine)").matches) {
        document.querySelectorAll<HTMLElement>("[data-spotlight]").forEach((card) => {
          card.addEventListener("pointermove", (event) => {
            const rect = card.getBoundingClientRect();
            card.style.setProperty("--mx", `${event.clientX - rect.left}px`);
            card.style.setProperty("--my", `${event.clientY - rect.top}px`);
          });
        });
      }
    </script>
  </body>
</html>
