---
import "@fontsource-variable/mona-sans/wght.css";
import LifecycleAccordion from "../components/LifecycleAccordion.astro";
import VolliDemo from "../components/VolliDemo";
import "../styles/global.css";

const repositoryUrl = "https://github.com/hussainph/volli-code";
const releasesUrl = `${repositoryUrl}/releases`;
const issuesUrl = `${repositoryUrl}/issues`;
const docsUrl = "https://docs.volli.app";
const description =
  "A local-first macOS workspace for planning parallel coding work, running coding agents, and reviewing every change.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href="https://volli.app/" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://volli.app/" />
    <meta property="og:title" content="Volli Code | The workspace for parallel coding agents" />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Volli Code | The workspace for parallel coding agents" />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/png" href="/volli-icon-dark.png" />
    <title>Volli Code | The workspace for parallel coding agents</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="footer-brand site-brand" href="#top" aria-label="Volli Code home">
        <img src="/volli-icon-dark.png" alt="" width="34" height="34" />
        <span>Volli</span>
      </a>
      <nav aria-label="Primary">
        <a href={docsUrl}>Docs</a>
        <a href={`${docsUrl}/start/quickstart/`}>Quickstart</a>
        <a href={repositoryUrl}>GitHub</a>
        <a class="site-nav-cta" href="/download/">Download</a>
      </nav>
    </header>

    <main id="main">
      {/* The promise before the picture: a visitor should know what this is and
          whether their Mac is supported before meeting an interactive fake UI. */}
      <section class="hero" id="top">
        <span class="alpha-pill">Alpha · Apple silicon</span>
        <h1 class="hero-headline">The workspace for parallel coding agents.</h1>
        <p class="hero-lede">
          Turn a rough idea into focused tasks yourself or with an agent. Run them in parallel and
          keep every chat, branch, and change in one place.
        </p>

        <div class="cta-row hero-cta">
          <a class="cta cta-primary" href="/download/">
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 2.6c.5 0 .9.4.9.9v8.9l3.2-3.2a.9.9 0 1 1 1.3 1.3l-4.8 4.7a.9.9 0 0 1-1.2 0L6.6 10.5a.9.9 0 1 1 1.3-1.3l3.2 3.2V3.5c0-.5.4-.9.9-.9Zm-7.5 14a.9.9 0 0 1 .9.9v1.6c0 .5.4.9.9.9h11.4c.5 0 .9-.4.9-.9v-1.6a.9.9 0 1 1 1.8 0v1.6a2.7 2.7 0 0 1-2.7 2.7H6.3a2.7 2.7 0 0 1-2.7-2.7v-1.6c0-.5.4-.9.9-.9Z"
              />
            </svg>
            <span>Download for Apple silicon</span>
          </a>
          <a class="cta cta-secondary" href={`${docsUrl}/start/quickstart/`}>
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
              <path
                fill="currentColor"
                d="M4 4.6c0-.6.5-1.1 1.1-1.1h4.3c1.1 0 2.1.5 2.6 1.4.6-.9 1.5-1.4 2.6-1.4h4.3c.6 0 1.1.5 1.1 1.1v13c0 .6-.5 1.1-1.1 1.1h-4.3c-.9 0-1.7.4-2.2 1.1a.9.9 0 0 1-1.5 0 2.6 2.6 0 0 0-2.2-1.1H5.1c-.6 0-1.1-.5-1.1-1.1v-13Zm7.1 12.2V6.6c0-.7-.6-1.3-1.3-1.3H5.8v11h3.6c.6 0 1.2.2 1.7.5Zm1.8 0c.5-.3 1.1-.5 1.7-.5h3.6v-11h-4c-.7 0-1.3.6-1.3 1.3v10.2Z"
              />
            </svg>
            <span>Read the quickstart</span>
          </a>
        </div>

        <p class="hero-alpha-note">
          <span>Apple silicon, M1 and later.</span>
          <a href={`${docsUrl}/start/install/`}>Install guide</a>
          <a href={releasesUrl}>Release notes</a>
          <a href={issuesUrl}>Report a problem</a>
        </p>
      </section>

      <section class="hero-shell" aria-label="Volli product preview">
        <VolliDemo client:load />
        {/* Labelled illustrative, not a pixel-accurate capture (VC-64). */}
        <p class="hero-preview-label">
          An interactive illustration, not a screenshot. Open a task to follow its work from plan to
          review.
        </p>
      </section>

      <section class="statement-section">
        <div class="statement-grid">
          <div class="accordion-column">
            <LifecycleAccordion />
          </div>

          <div class="statement-copy">
            <h2 class="statement-headline">From idea to reviewed code</h2>

            <div class="body-copy">
              <p>
                Start with a rough idea. Create focused tasks yourself, or ask an agent to help break
                the work down. The board keeps every task visible while you decide what moves forward.
              </p>
              <p>
                Start an agent chat for each task that is ready to implement. Volli gives the task its
                own Git worktree and branch, so independent work stays out of your main checkout.
              </p>
              <p>
                When a task is ready for review, return to its chat, files, and changes. Choose a
                model in <a href={`${docsUrl}/guides/settings/`}>Model Access</a>, inspect the work,
                and open Claude Code, Codex, OpenCode, or your own TUI in an embedded terminal when
                you want to drive it yourself.
              </p>
            </div>

            <div class="cta-row">
              <a class="cta cta-primary" href="/download/">
                <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M12 2.6c.5 0 .9.4.9.9v8.9l3.2-3.2a.9.9 0 1 1 1.3 1.3l-4.8 4.7a.9.9 0 0 1-1.2 0L6.6 10.5a.9.9 0 1 1 1.3-1.3l3.2 3.2V3.5c0-.5.4-.9.9-.9Zm-7.5 14a.9.9 0 0 1 .9.9v1.6c0 .5.4.9.9.9h11.4c.5 0 .9-.4.9-.9v-1.6a.9.9 0 1 1 1.8 0v1.6a2.7 2.7 0 0 1-2.7 2.7H6.3a2.7 2.7 0 0 1-2.7-2.7v-1.6c0-.5.4-.9.9-.9Z"
                  />
                </svg>
                <span>Download for Apple silicon</span>
              </a>
              <a class="cta cta-secondary" href={repositoryUrl}>
                <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.74-1.55-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.79 1.07.79 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"
                  />
                </svg>
                <span>View source on GitHub</span>
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <a class="footer-brand" href="#top" aria-label="Volli home">
        <img src="/volli-icon-dark.png" alt="" width="34" height="34" />
        <span>Volli</span>
      </a>
      <nav aria-label="Footer">
        <a href="/download/">Download</a>
        <a href={docsUrl}>Docs</a>
        <a href={`${docsUrl}/start/quickstart/`}>Quickstart</a>
        <a href={repositoryUrl}>GitHub</a>
        <a href={releasesUrl}>Releases</a>
        <a href={`${repositoryUrl}/security/policy`}>Security</a>
        <a href={issuesUrl}>Feedback</a>
      </nav>
    </footer>
  </body>
</html>
