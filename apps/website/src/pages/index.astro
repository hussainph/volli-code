---
/**
 * volli.app (BRAND.md §9): the product in its world, an essay, the current
 * release told as chapters, and the close.
 *
 * The release lives in the chapters and nowhere else, so the next release
 * replaces them and leaves the rest of the page alone.
 */
import armedTall from "../assets/stills/armed-tall.webp";
import armedWide from "../assets/stills/armed-wide.webp";
import cursorTall from "../assets/stills/cursor-tall.webp";
import cursorWide from "../assets/stills/cursor-wide.webp";
import islandTall from "../assets/stills/island-tall.webp";
import islandWide from "../assets/stills/island-wide.webp";
import limitsTall from "../assets/stills/limits-tall.webp";
import limitsWide from "../assets/stills/limits-wide.webp";
import mcpTall from "../assets/stills/mcp-tall.webp";
import mcpWide from "../assets/stills/mcp-wide.webp";
import modelsTall from "../assets/stills/models-tall.webp";
import modelsWide from "../assets/stills/models-wide.webp";
import splitTall from "../assets/stills/split-tall.webp";
import splitWide from "../assets/stills/split-wide.webp";
import Chapter from "../components/Chapter.astro";
import Mark from "../components/Mark.astro";
import Super from "../components/Super.astro";
import VolliDemo from "../components/VolliDemo";
import World from "../components/World.astro";
import { DOCS_URL, REPOSITORY_URL } from "../data/links";
import Base from "../layouts/Base.astro";

const description =
  "Volli is a local-first Mac workspace for running coding agents in parallel: plan on a board, hand each ticket to an agent in its own worktree, and review every change.";
---

<Base
  title="Volli | The workspace for parallel coding agents"
  description={description}
  path="/"
>
  {/* tabindex so the skip link moves focus in Safari, not just the viewport. */}
  <main id="main" tabindex="-1">
    {/* The promise, one line, and the one thing to press. Left-set, beside
        the picture rather than stacked over it. */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-head">
        <Super
          size="hero"
          level={1}
          id="hero-title"
          beats={[{ text: "The workspace for" }, { text: "parallel coding agents.", bold: true }]}
        />
        <div class="hero-action">
          <a class="button" href="/download/">Download for Mac</a>
          <p class="hero-note">Alpha · Apple silicon</p>
        </div>
      </div>

      {/* The product in its world: the same interactive board the first site
          opened on. Drag a ticket and its chat opens. */}
      <div class="hero-demo">
        <VolliDemo client:load />
      </div>
      <p class="hero-caption">It’s live — drag a ticket, or open one.</p>
    </section>

    {/* The essay (BRAND.md §3): the one place the page talks at length. */}
    <section class="essay" aria-labelledby="essay-title">
      <div class="essay-lockup">
        <Mark size={72} />
        <h2 class="essay-name" id="essay-title">Volli</h2>
        <p class="essay-version">0.2 · alpha</p>
      </div>
      <div class="essay-body">
        <p>
          Coding agents got good. Good enough that the hard part is no longer one agent. It’s six of
          them, each halfway through something, each wanting you at a different moment.
        </p>
        <p>
          Volli is a workspace for that. Plan on a board. Hand a ticket to an agent, and it works in
          its own Git worktree on its own branch, out of your checkout and out of the others’ way.
          You can see which agents are working and which are waiting on you. When one is done, you
          review the change and decide what ships.
        </p>
        <p>
          Bring the models and accounts you already pay for. And when you would rather drive
          yourself, Claude Code, Codex, or any terminal tool runs right beside the chat, in the same
          worktree.
        </p>
        <p>
          It stays yours. Your projects and history live on your Mac, there is no Volli account,
          and the source is open under Apache-2.0.
        </p>
        <p>0.2 is the release where agents start on their own.</p>
        <div class="essay-actions">
          <a class="button" href="/download/">Download for Mac</a>
          <a class="link-quiet" href={DOCS_URL}>Read the docs <span aria-hidden="true">→</span></a>
          <a class="link-quiet" href={REPOSITORY_URL}
            >Source on GitHub <span aria-hidden="true">→</span></a
          >
        </div>
      </div>
    </section>

    {/* The release, as the film tells it: one chapter per headline, each in
        its own world. */}
    <section class="release" id="new" aria-labelledby="release-title">
      <header class="release-head">
        <h2 id="release-title">New in 0.2</h2>
        <a class="link-quiet" href={`${DOCS_URL}/releases/whats-new-0-2/`}
          >Everything in 0.2 <span aria-hidden="true">→</span></a
        >
      </header>

      <Chapter
        id="automations"
        world="lagoon"
        wide={armedWide}
        tall={armedTall}
        alt="Three tickets land in an armed Doing column; each shows an Implement countdown with a Cancel button."
        eyebrow="Automations"
        beats={[{ text: "Agents start", bold: true }, { text: "on their own." }]}
        sub="Save how work starts. Run it by hand, when a ticket enters a column, or on a schedule."
        place="bottom-left"
        focus={[0.7, 0.45]}
      />

      <Chapter
        id="activity"
        world="cobalt"
        wide={islandWide}
        tall={islandTall}
        alt="The activity island opened into layers: the agent's plan, its subagents, background shells and browser tabs."
        eyebrow="Activity"
        beats={[{ text: "See everything", bold: true }, { text: "your agent does." }]}
        sub="Its plan, subagents, shells and browser tabs, one glance above the composer."
        place="bottom-left"
        focus={[0.72, 0.4]}
      />

      <Chapter
        id="browser"
        world="aurora"
        wide={cursorWide}
        tall={cursorTall}
        alt="A checkout page in a browser tab, with the agent's cursor pressing Continue to payment."
        eyebrow="Browser tabs"
        beats={[{ text: "Share a browser", bold: true }, { text: "with your agent." }]}
        sub="Watch every click it makes, and take the tab back whenever you like."
        place="bottom-right"
        focus={[0.3, 0.45]}
      />

      <Chapter
        id="split"
        world="rose"
        wide={splitWide}
        tall={splitTall}
        alt="A split view: a terminal running tests beside a chat and its sessions."
        eyebrow="Split view"
        beats={[{ text: "Chats, browsers, terminals.", bold: true }, { text: "Side by side." }]}
        place="bottom-right"
        focus={[0.4, 0.4]}
      />

      <div class="montage">
        <Chapter
          id="limits"
          size="small"
          world="gold"
          wide={limitsWide}
          tall={limitsTall}
          alt="The usage limits popover: session and weekly windows with time left until they reset."
          beats={[{ text: "Your limits," }, { text: "always in view.", bold: true }]}
          place="top-left"
        />
        <Chapter
          id="models"
          size="small"
          world="lime"
          wide={modelsWide}
          tall={modelsTall}
          alt="Default models for board chats, ticket sessions, and the Fast, Deep and Visual tiers."
          beats={[{ text: "A model for" }, { text: "every subagent.", bold: true }]}
          place="top-left"
        />
        <Chapter
          id="mcp"
          size="small"
          world="cobalt"
          wide={mcpWide}
          tall={mcpTall}
          alt="Settings, MCP servers: four servers, their tools, and their status."
          beats={[{ text: "Plug in" }, { text: "any MCP server.", bold: true }]}
          place="top-left"
        />
      </div>
    </section>

    {/* The close: the film's end card, as a page. */}
    <World as="section" world="ember" class="close" focus={[0.5, 0.42]} aria-labelledby="close-title">
      <div class="close-inner" data-reveal>
        <Mark size={132} build />
        <Super
          size="hero"
          id="close-title"
          beats={[{ text: "Volli 0.2", bold: true }]}
          sub="The workspace for parallel coding agents."
        />
        <div class="close-actions">
          <a class="button" href="/download/">Download for Mac</a>
          <a class="link-quiet" href={DOCS_URL}>Read the docs <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </World>
  </main>
</Base>
