---
/**
 * volli.app (BRAND.md §9): what Volli is, why you would use it, and its core
 * features — each one a picture of the real app in its own world, with the
 * words above it.
 *
 * The copy is Option A from the copy review (`.scratch/copy/OPTIONS.md`), a
 * working draft until the owner picks.
 */
import Chapter from "../components/Chapter.astro";
import Mark from "../components/Mark.astro";
import Super from "../components/Super.astro";
import VolliDemo from "../components/VolliDemo";
import World from "../components/World.astro";
import { DOCS_URL, REPOSITORY_URL } from "../data/links";
import { still } from "../data/stills";
import GitHubIcon from "../components/GitHubIcon.astro";
import Base from "../layouts/Base.astro";

const WHY = [
  {
    title: "Each task has one home",
    body: "A ticket holds its chats, branch and changes, so you never match a chat window to an issue by hand.",
  },
  {
    title: "Switching is the point",
    body: "Peek at any chat from the sidebar and reply without leaving the task you're in.",
  },
  {
    title: "Agents plan with you",
    body: "Agents can create tickets and start chats, so the board grows with the work.",
  },
  {
    title: "Come back to it later",
    body: "Leave for a week. Every task still has its full history when you return.",
  },
  {
    title: "Use what you pay for",
    body: "Sign in with your coding subscriptions and choose a model for each task.",
  },
] as const;

const description =
  "Run coding agents in parallel on your Mac. Volli keeps each ticket with its chats, branch and changes so you can return to the work after time away.";
---

<Base
  title="Volli | A Mac workspace for parallel coding agents"
  description={description}
  path="/"
>
  {/* tabindex so the skip link moves focus in Safari, not just the viewport. */}
  <main id="main" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-head">
        <div class="hero-words">
          <Super
            size="hero"
            level={1}
            id="hero-title"
            beats={[{ text: "A workspace for" }, { text: "parallel coding agents", bold: true }]}
          />
          <p class="hero-lede hero-rise" style="--rise: 3">
            Volli brings your tickets and agent chats into one Mac app. Run tasks in parallel and
            return to each task's history when you come back.
          </p>
        </div>
        <div class="hero-action hero-rise" style="--rise: 4">
          <div class="hero-buttons">
            <a class="button" href="/download/">Download for Mac</a>
            <a class="button button--ghost" href={REPOSITORY_URL}>
              <GitHubIcon />
              <span>Star on GitHub</span>
            </a>
          </div>
          <p class="hero-note">Free and open source under Apache-2.0. Alpha for Apple silicon Macs.</p>
        </div>
      </div>

      <div class="hero-demo hero-rise" style="--rise: 5">
        <VolliDemo client:load />
      </div>
    </section>

    <section class="essay" aria-labelledby="essay-title">
      <div class="essay-lockup">
        <Mark size={72} />
        <h2 class="essay-name" id="essay-title">Volli</h2>
      </div>
      <div class="essay-body">
        {/* Each sentence lights up as it scrolls into the reading line. */}
        <p class="essay-read">
          <span class="read">On a long-running project, you can lose track of which ticket belongs to which chat window or terminal pane.</span>{" "}
          <span class="read">Volli keeps the ticket and its agent chats together.</span>{" "}
          <span class="read">Plan tasks on the board, run them in parallel, and check the sidebar to see which agents need you.</span>{" "}
          <span class="read">When you return, each task still has its history.</span>
        </p>
      </div>
    </section>

    <section class="features" aria-label="Features">
      <Chapter
        id="tickets"
        order={0}
        span={7}
        world="ember"
        still={still("rail")}
        alt="A ticket's sidebar: its status, priority and labels, its two chats, and its branch."
        beats={[{ text: "Keep each task's" }, { text: "work together", bold: true }]}
        body="A ticket is a task in Volli. It keeps your brief, chats, branch and changes together. Close a chat or quit the app, then return to the same history a week later."
      />

      <Chapter
        id="peek"
        order={1}
        span={5}
        world="aurora"
        still={still("peek")}
        alt="The sidebar's active chats; hovering one opens a card with its latest message and a reply box."
        beats={[{ text: "Reply without" }, { text: "leaving your place", bold: true }]}
        body="The sidebar shows which agents are working and which need you. Hover a chat to peek at it, then reply from an overlay while keeping your current task open."
      />

      <Chapter
        id="split"
        order={0}
        span={5}
        world="rose"
        still={still("split")}
        alt="A split view: a terminal running tests beside a chat."
        beats={[{ text: "Put a terminal" }, { text: "beside your chat", bold: true }]}
        body="Open a chat and a terminal side by side. Run commands or your own command-line agent in the task's branch while its conversation stays in view."
      />

      <Chapter
        id="browser"
        order={1}
        span={7}
        world="lagoon"
        still={still("cursor")}
        alt="A checkout page in a browser tab, with the agent's cursor pressing Continue to payment."
        beats={[{ text: "Share a browser" }, { text: "with your agent", bold: true }]}
        body="Watch the agent's cursor as it checks a page. Take over the browser tab when you want to try something yourself, then hand it back."
      />

      <Chapter
        id="activity"
        order={0}
        span={7}
        world="cobalt"
        still={still("island")}
        alt="A chat's activity opened into layers: the agent's plan, the agents it started, background commands and browser tabs."
        beats={[{ text: "Let agents help" }, { text: "start the work", bold: true }]}
        body="Ask an agent to create tickets and start chats for them. In each chat, follow its plan, the agents it starts, background commands and browser tabs."
      />

      <Chapter
        id="models"
        order={1}
        span={5}
        world="lime"
        still={still("models")}
        alt="Default models for board chats, ticket chats, and the Fast, Deep and Visual tiers."
        beats={[{ text: "Use subscriptions" }, { text: "you already pay for", bold: true }]}
        body="Sign in with the coding subscriptions you already have. Choose a model for each task, and set defaults for the agents it starts."
      />

      <Chapter
        id="automations"
        order={0}
        span={6}
        world="gold"
        still={still("armed")}
        alt="Three tickets land in a Doing column set to start agents; each shows an Implement countdown with a Cancel button."
        beats={[{ text: "Choose when" }, { text: "agents start", bold: true }]}
        body="Save instructions for repeated work. Choose them while dragging a ticket, or enable an automation on a column so it runs when a ticket enters."
      />

      <Chapter
        id="limits"
        order={1}
        span={3}
        world="ember"
        still={still("limits")}
        alt="The usage limits popover: session and weekly windows with time left until they reset."
        beats={[{ text: "See your usage", bold: true }, { text: "and reset times." }]}
      />

      <Chapter
        id="mcp"
        order={2}
        span={3}
        world="cobalt"
        still={still("mcp")}
        alt="Settings, MCP servers: four servers, their tools, and their status."
        beats={[{ text: "Add tools", bold: true }, { text: "with MCP servers." }]}
      />

    </section>

    {/* What makes Volli different, said about Volli alone. */}
    <section class="why" aria-labelledby="why-title">
      <div class="why-head" data-reveal>
        <Super
          id="why-title"
          beats={[{ text: "Made for many agents" }, { text: "at once", bold: true }]}
        />
      </div>
      <ol class="why-list">
        {
          WHY.map((item, index) => (
            <li class="why-item" data-reveal style={`--stagger: ${index}`}>
              <span class="why-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ol>
      <figure class="why-quote" data-reveal>
        <blockquote>
          <p>
            Before Volli, I could keep four to six agents going at once. Now I regularly run fifteen
            to twenty, and I can leave for a week and pick up where I left off.
          </p>
        </blockquote>
        <figcaption>Hussain Phalasiya, who builds Volli</figcaption>
      </figure>
    </section>

    <World
      as="section"
      world="ember"
      class="close"
      shader="mesh"
      focus={[0.5, 0.42]}
      aria-labelledby="close-title"
    >
      <div class="close-inner" data-reveal>
        <Mark size={132} build />
        <Super
          size="hero"
          id="close-title"
          beats={[{ text: "Start a chat on" }, { text: "your first ticket", bold: true }]}
          sub="Add your project, write a task, and choose the model you want to use."
        />
        <div class="close-actions">
          <a class="button" href="/download/">Download for Mac</a>
          <a class="link-quiet" href={DOCS_URL}>Read the docs <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </World>
  </main>
</Base>
