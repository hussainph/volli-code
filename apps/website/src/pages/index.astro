---
/**
 * volli.app (BRAND.md §9): what Volli is, why you would use it, and its core
 * features — each one a picture of the real app in its own world, with the
 * words above it.
 *
 * The copy is Option A from the copy review (`.scratch/copy/OPTIONS.md`), a
 * working draft until the owner picks.
 */
import introMp4 from "../assets/hero/intro.mp4";
import introWebm from "../assets/hero/intro.webm";
import loopMp4 from "../assets/hero/loop.mp4";
import loopWebm from "../assets/hero/loop.webm";
import heroPoster from "../assets/hero/poster.webp";
import Chapter from "../components/Chapter.astro";
import Feed from "../components/Feed.astro";
import Mark from "../components/Mark.astro";
import Super from "../components/Super.astro";
import World from "../components/World.astro";
import { DOCS_URL, REPOSITORY_URL } from "../data/links";
import { still } from "../data/stills";
import GitHubIcon from "../components/GitHubIcon.astro";
import Base from "../layouts/Base.astro";

// None of these repeat a bento card: this is what's left of the answer to
// "why not the agent app I already have?"
const WHY = [
  {
    title: "Agents never collide",
    body: "Each ticket can get its own worktree and branch, so agents never write over each other's code.",
  },
  {
    title: "Diff to pull request",
    body: "Read a ticket's changes, commit them, and open a draft pull request without leaving the app.",
  },
  {
    title: "Bring your CLI agents",
    body: "Run any command-line agent in a terminal tab, right inside the ticket's worktree.",
  },
  {
    title: "Stays on your Mac",
    body: "Projects, tickets and chats are stored locally. Model requests go only to the provider you pick.",
  },
  {
    title: "Free and open source",
    body: "Apache-2.0. Read the code, or build it yourself.",
  },
] as const;

// Invented, public-safe work in the register of the film's sidebar.
const AGENTS = [
  "Split the billing service",
  "Profile slow search query",
  "Migrate auth to passkeys",
  "Draft release notes",
  "Cache avatar thumbnails",
] as const;

const description =
  "Build like a team of twenty. Volli is a Mac app for building ambitious software with many coding agents at once. Every task keeps its chats, code and history, so you can pick it back up where you left off.";
---

<Base
  title="Volli | Build like a team of twenty"
  description={description}
  path="/"
>
  {/* tabindex so the skip link moves focus in Safari, not just the viewport. */}
  <main id="main" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-head">
        <div class="hero-words">
          <Super
            size="hero"
            level={1}
            id="hero-title"
            speed
            beats={[{ text: "Build like" }, { text: "a team of twenty.", bold: true }]}
          />
          <p class="hero-lede hero-rise" style="--rise: 3">
            Volli is a Mac app for building ambitious software with many coding agents at once.
            Every task keeps its chats, code and history, so you can hand off more work and pick it
            back up exactly where you left off.
          </p>
        </div>
        <div class="hero-action hero-rise" style="--rise: 4">
          <div class="hero-buttons">
            <a class="button" href="/download/">Download for Mac</a>
            <a class="button button--ghost" href={REPOSITORY_URL}>
              <GitHubIcon />
              <span>Star on GitHub</span>
            </a>
          </div>
          <p class="hero-note">Free and open source under Apache-2.0. Alpha for Apple silicon Macs.</p>
        </div>
      </div>

      {/* The real app, not a mock: a sweep down a sidebar of live agents that
          pulls back to the whole window, then drifts forever. Two videos: the
          intro plays once and hands off to a loop that starts on its last
          frame. Under reduced motion the page shows only that frame.
          (apps/desktop/scripts/film/web-hero.mjs) */}
      <div class="hero-film hero-rise" style="--rise: 5" data-hero-film>
        <img
          class="hero-poster"
          src={heroPoster.src}
          width={heroPoster.width}
          height={heroPoster.height}
          alt="Volli with a sidebar full of agents at work, beside a board of tickets."
        />
        <video class="hero-video hero-loop" muted playsinline loop preload="none" aria-hidden="true">
          <source src={loopMp4} type="video/mp4" />
          <source src={loopWebm} type="video/webm" />
        </video>
        <video class="hero-video hero-intro" muted playsinline preload="auto" aria-hidden="true">
          <source src={introMp4} type="video/mp4" />
          <source src={introWebm} type="video/webm" />
        </video>
      </div>
    </section>

    <section class="essay" aria-labelledby="essay-title">
      <div class="essay-lockup">
        <Mark size={72} />
        <h2 class="essay-name" id="essay-title">Volli</h2>
      </div>
      <div class="essay-body">
        {/* Each sentence lights up as it scrolls into the reading line. */}
        <p class="essay-read">
          <span class="read">It's easy to start a dozen coding agents.</span>{" "}
          <span class="read">It's just as easy to lose track of what they're all up to.</span>
        </p>
        <p class="essay-read">
          <span class="read">In Volli, each task is a ticket.</span>{" "}
          <span class="read">A ticket holds the brief, the agents working on it, and the changes they make.</span>
        </p>
        <p class="essay-read">
          <span class="read">All your tickets sit on one board, so you can see which ones have agents working and which are waiting on you.</span>{" "}
          <span class="read">Open any ticket to review its changes or pick up right where it stopped.</span>
        </p>
      </div>
    </section>

    <section class="features" aria-label="Features">
      <Chapter
        id="tickets"
        order={0}
        span={7}
        world="ember"
        still={still("rail")}
        alt="A ticket's sidebar: its status, priority and labels, its two chats, and its branch."
        beats={[{ text: "Never lose" }, { text: "the thread", bold: true }]}
        body="Every task keeps its brief, chats, branch and changes. Come back in a week and it's all still there."
      />

      <Chapter
        id="peek"
        order={1}
        span={5}
        world="aurora"
        still={still("peek")}
        alt="The sidebar's active chats; hovering one opens a card with its latest message and a reply box."
        beats={[{ text: "Unblock an agent" }, { text: "in seconds", bold: true }]}
        body="Hover over an agent to read its latest message and reply. Then get right back to your work."
      />

      <Chapter
        id="split"
        order={0}
        span={5}
        world="rose"
        still={still("split")}
        alt="A split view: a terminal running tests beside a chat."
        beats={[{ text: "Tabs for everything," }, { text: "side by side", bold: true }]}
        body="Chats, terminals, files and browsers each open in a tab. Split the view to keep any of them next to each other."
      />

      <Chapter
        id="browser"
        order={1}
        span={7}
        world="lagoon"
        still={still("cursor")}
        alt="A checkout page in a browser tab, with the agent's cursor pressing Continue to payment."
        beats={[{ text: "Browse the web" }, { text: "with your agents", bold: true }]}
        body="Your agent drives a real browser tab. Watch it click through your app, or take over at any time."
      />

      {/* No still here: five of the sidebar's rows arrive and start working
          together (Feed.astro). */}
      <Chapter
        id="activity"
        order={0}
        span={7}
        world="cobalt"
        beats={[{ text: "Let your agents" }, { text: "organize the work", bold: true }]}
        body="Agents can write tickets, move them across the board, and start other agents. You don't have to run it all yourself."
      >
        <Feed slot="window" rows={AGENTS} label="Five agents, all working" />
      </Chapter>

      <Chapter
        id="models"
        order={1}
        span={5}
        world="lime"
        still={still("models")}
        alt="Default models for board chats, ticket chats, and the Fast, Deep and Visual tiers."
        beats={[{ text: "Bring your" }, { text: "own tokens", bold: true }]}
        body="Connect any of 40+ model providers with the plan or API key you already have. Pick the right model for each task."
      />

      <Chapter
        id="automations"
        order={0}
        span={6}
        world="gold"
        still={still("armed")}
        alt="Three tickets land in a Doing column set to start agents; each shows an Implement countdown with a Cancel button."
        beats={[{ text: "Automate" }, { text: "the routine work", bold: true }]}
        body="Save a workflow once. Run it on a schedule, or whenever a ticket lands in a column."
      />

      <Chapter
        id="limits"
        order={1}
        span={3}
        world="ember"
        still={still("limits")}
        alt="The usage limits popover: session and weekly windows with time left until they reset."
        beats={[{ text: "No surprise", bold: true }, { text: "usage limits." }]}
      />

      <Chapter
        id="mcp"
        order={2}
        span={3}
        world="cobalt"
        still={still("mcp")}
        alt="Settings, MCP servers: four servers, their tools, and their status."
        beats={[{ text: "Bring your tools", bold: true }, { text: "with MCP servers." }]}
      />

    </section>

    {/* What makes Volli different, said about Volli alone. */}
    <section class="why" aria-labelledby="why-title">
      <div class="why-head" data-reveal>
        <Super
          id="why-title"
          beats={[{ text: "Built for" }, { text: "many agents,", bold: true }, { text: "not one." }]}
        />
      </div>
      <ul class="why-list">
        {
          WHY.map((item, index) => (
            <li class="why-item" data-reveal style={`--stagger: ${index}`}>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <World
      as="section"
      world="ember"
      class="close"
      shader="mesh"
      focus={[0.5, 0.42]}
      aria-labelledby="close-title"
    >
      <div class="close-inner" data-reveal>
        <Mark size={132} build />
        <Super
          size="hero"
          id="close-title"
          beats={[{ text: "Start with" }, { text: "one ticket", bold: true }]}
          sub="Free for Apple silicon Macs. Open source."
        />
        <div class="close-actions">
          <a class="button" href="/download/">Download for Mac</a>
          <a class="link-quiet" href={DOCS_URL}>Read the docs <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </World>
  </main>

  <script>
    // The hero film: play the intro once, start the loop underneath it just
    // before it ends, then drop the intro. Nothing plays under reduced motion.
    const film = document.querySelector<HTMLElement>("[data-hero-film]");
    const intro = film?.querySelector<HTMLVideoElement>(".hero-intro");
    const loop = film?.querySelector<HTMLVideoElement>(".hero-loop");
    if (film && intro && loop && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      loop.preload = "auto";
      loop.load();
      intro.addEventListener("playing", () => film.setAttribute("data-playing", ""), { once: true });
      intro.addEventListener("ended", () => {
        void loop.play().then(() => film.setAttribute("data-looping", ""));
      });
      void intro.play().catch(() => film.setAttribute("data-still", ""));
    }
  </script>
</Base>
