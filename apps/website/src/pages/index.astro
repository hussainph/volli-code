---
import "@fontsource-variable/mona-sans/wght.css";
import MorphingText from "../components/MorphingText";
import LifecycleAccordion from "../components/LifecycleAccordion.astro";
import VolliDemo from "../components/VolliDemo";
import "../styles/global.css";

const repositoryUrl = "https://github.com/hussainph/volli-code";
const docsUrl = "https://docs.volli.app";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="A local-first macOS workspace for Tickets, durable Pi-backed Sessions, isolated Git worktrees, and live code review."
    />
    <link rel="canonical" href="https://volli.app/" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://volli.app/" />
    <meta property="og:title" content="Volli Code | Plan and run coding agents" />
    <meta
      property="og:description"
      content="A local-first macOS workspace for Tickets, durable Pi-backed Sessions, isolated Git worktrees, and live code review."
    />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Volli Code | Plan and run coding agents" />
    <meta
      name="twitter:description"
      content="A local-first macOS workspace for Tickets, durable Pi-backed Sessions, isolated Git worktrees, and live code review."
    />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/png" href="/volli-icon-dark.png" />
    <title>Volli Code | Plan and run coding agents</title>
  </head>
  <body>
    <main id="top">
      <section class="hero-shell" aria-label="Interactive Volli product preview">
        <VolliDemo client:load />
        <p class="hero-preview-label">Interactive product preview — drag tickets or open one to explore.</p>
      </section>

      <section class="statement-section">
        <div class="statement-grid">
          <div class="accordion-column">
            <LifecycleAccordion />
          </div>

          <div class="statement-copy">
            <h1 class="statement-headline">
              <span class="headline-lead">The ticket is</span>
              <MorphingText
                client:load
                texts={[
                  "the plan",
                  "the starting context",
                  "a focused workspace",
                  "the review surface",
                  "the project history",
                ]}
              />
            </h1>

            <div class="body-copy">
              <p>
                Volli is a local-first macOS workspace for Tickets, durable Pi-backed Sessions,
                isolated Git worktrees, and live Change Sets.
              </p>
              <p>
                Plan the work in a Ticket, then start a Ticket or project Session with its context
                and history intact. When a Ticket needs implementation, its Git worktree stays an
                explicit, isolated checkout—not a replacement for the Ticket itself.
              </p>
              <p>
                Pi powers Volli’s structured runtime. External and bring-your-own CLI harnesses
                stay available as manual terminal companions, while the board, Sessions, and review
                remain a coherent product surface.
              </p>
            </div>

            <div class="cta-row">
              <a class="cta cta-primary" href="/download/">
                <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M12 2.6c.5 0 .9.4.9.9v8.9l3.2-3.2a.9.9 0 1 1 1.3 1.3l-4.8 4.7a.9.9 0 0 1-1.2 0L6.6 10.5a.9.9 0 1 1 1.3-1.3l3.2 3.2V3.5c0-.5.4-.9.9-.9Zm-7.5 14a.9.9 0 0 1 .9.9v1.6c0 .5.4.9.9.9h11.4c.5 0 .9-.4.9-.9v-1.6a.9.9 0 1 1 1.8 0v1.6a2.7 2.7 0 0 1-2.7 2.7H6.3a2.7 2.7 0 0 1-2.7-2.7v-1.6c0-.5.4-.9.9-.9Z"
                  />
                </svg>
                <span>Download for macOS</span>
              </a>
              <a class="cta cta-secondary" href={repositoryUrl}>
                <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.74-1.55-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.79 1.07.79 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"
                  />
                </svg>
                <span>View source on GitHub</span>
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <a class="footer-brand" href="#top" aria-label="Volli home">
        <img src="/volli-icon-dark.png" alt="" width="34" height="34" />
        <span>Volli</span>
      </a>
      <nav aria-label="Footer">
        <a href="/download/">Download</a>
        <a href={docsUrl}>Docs</a>
        <a href={repositoryUrl}>GitHub</a>
        <a href={`${repositoryUrl}#readme`}>Readme</a>
      </nav>
    </footer>
  </body>
</html>
