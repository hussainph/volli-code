---
/**
 * volli.app (BRAND.md §9): what Volli is, why you would use it, and its core
 * features — each one a picture of the real app in its own world, with the
 * words above it.
 *
 * The copy is Option A from the copy review (`.scratch/copy/OPTIONS.md`), a
 * working draft until the owner picks.
 */
import introMp4 from "../assets/hero/intro.mp4";
import introWebm from "../assets/hero/intro.webm";
import loopMp4 from "../assets/hero/loop.mp4";
import loopWebm from "../assets/hero/loop.webm";
import heroPoster from "../assets/hero/poster.webp";
import Chapter from "../components/Chapter.astro";
import Mark from "../components/Mark.astro";
import Super from "../components/Super.astro";
import World from "../components/World.astro";
import { DOCS_URL, REPOSITORY_URL } from "../data/links";
import { still } from "../data/stills";
import GitHubIcon from "../components/GitHubIcon.astro";
import Base from "../layouts/Base.astro";

const WHY = [
  { title: "One home per task", body: "No more matching chat windows to issues." },
  { title: "Switching is free", body: "Jump between agents without losing your place." },
  { title: "Agents that plan", body: "They write tickets and start each other." },
  { title: "Walk away", body: "A week later, every task is where you left it." },
  { title: "Your own plans", body: "Use the coding subscriptions you already pay for." },
] as const;

const description =
  "Volli is a Mac app for running coding agents in parallel. Every task keeps its chats, code and history, so you can run more agents and pick any project back up where you left it.";
---

<Base
  title="Volli | Dozens of agents, one clear head"
  description={description}
  path="/"
>
  {/* tabindex so the skip link moves focus in Safari, not just the viewport. */}
  <main id="main" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-head">
        <div class="hero-words">
          <Super
            size="hero"
            level={1}
            id="hero-title"
            beats={[{ text: "Dozens of agents." }, { text: "One clear head.", bold: true }]}
          />
          <p class="hero-lede hero-rise" style="--rise: 3">
            Volli keeps every task's chats, code and history in one Mac app. Run more agents than
            you could ever juggle, and pick any project back up exactly where you left it.
          </p>
        </div>
        <div class="hero-action hero-rise" style="--rise: 4">
          <div class="hero-buttons">
            <a class="button" href="/download/">Download for Mac</a>
            <a class="button button--ghost" href={REPOSITORY_URL}>
              <GitHubIcon />
              <span>Star on GitHub</span>
            </a>
          </div>
          <p class="hero-note">Free and open source under Apache-2.0. Alpha for Apple silicon Macs.</p>
        </div>
      </div>

      {/* The real app, not a mock: a sweep down a sidebar of live agents that
          pulls back to the whole window, then drifts forever. Two videos: the
          intro plays once and hands off to a loop that starts on its last
          frame. Under reduced motion the page shows only that frame.
          (apps/desktop/scripts/film/web-hero.mjs) */}
      <div class="hero-film hero-rise" style="--rise: 5" data-hero-film>
        <img
          class="hero-poster"
          src={heroPoster.src}
          width={heroPoster.width}
          height={heroPoster.height}
          alt="Volli with a sidebar full of agents at work, beside a board of tickets."
        />
        <video class="hero-video hero-loop" muted playsinline loop preload="none" aria-hidden="true">
          <source src={loopMp4} type="video/mp4" />
          <source src={loopWebm} type="video/webm" />
        </video>
        <video class="hero-video hero-intro" muted playsinline preload="auto" aria-hidden="true">
          <source src={introMp4} type="video/mp4" />
          <source src={introWebm} type="video/webm" />
        </video>
      </div>
    </section>

    <section class="essay" aria-labelledby="essay-title">
      <div class="essay-lockup">
        <Mark size={72} />
        <h2 class="essay-name" id="essay-title">Volli</h2>
      </div>
      <div class="essay-body">
        {/* Each sentence lights up as it scrolls into the reading line. */}
        <p class="essay-read">
          <span class="read">Chat windows, terminal panes and your issue tracker don't know about each other.</span>{" "}
          <span class="read">So you end up holding it all in your head.</span>{" "}
          <span class="read">Volli puts each task and its agents in one place,</span>{" "}
          <span class="read">so the work is always where you left it.</span>
        </p>
      </div>
    </section>

    <section class="features" aria-label="Features">
      <Chapter
        id="tickets"
        order={0}
        span={7}
        world="ember"
        still={still("rail")}
        alt="A ticket's sidebar: its status, priority and labels, its two chats, and its branch."
        beats={[{ text: "Never lose" }, { text: "the thread", bold: true }]}
        body="Every task keeps its brief, chats, branch and changes. Come back in a week and it's all still there."
      />

      <Chapter
        id="peek"
        order={1}
        span={5}
        world="aurora"
        still={still("peek")}
        alt="The sidebar's active chats; hovering one opens a card with its latest message and a reply box."
        beats={[{ text: "Unblock an agent" }, { text: "in seconds", bold: true }]}
        body="See who needs you at a glance. Hover, reply, and you're still right where you were."
      />

      <Chapter
        id="split"
        order={0}
        span={5}
        world="rose"
        still={still("split")}
        alt="A split view: a terminal running tests beside a chat."
        beats={[{ text: "Watch it work," }, { text: "side by side", bold: true }]}
        body="Put a terminal next to the chat. Run the tests yourself while the agent keeps going."
      />

      <Chapter
        id="browser"
        order={1}
        span={7}
        world="lagoon"
        still={still("cursor")}
        alt="A checkout page in a browser tab, with the agent's cursor pressing Continue to payment."
        beats={[{ text: "See what" }, { text: "your agent sees", bold: true }]}
        body="Your agent drives a real browser tab. Follow its cursor, or take the wheel."
      />

      <Chapter
        id="activity"
        order={0}
        span={7}
        world="cobalt"
        still={still("island")}
        alt="A chat's activity opened into layers: the agent's plan, the agents it started, background commands and browser tabs."
        beats={[{ text: "Agents that" }, { text: "split up the work", bold: true }]}
        body="Agents plan tickets and start other agents. You see every step, command and tab they open."
      />

      <Chapter
        id="models"
        order={1}
        span={5}
        world="lime"
        still={still("models")}
        alt="Default models for board chats, ticket chats, and the Fast, Deep and Visual tiers."
        beats={[{ text: "Nothing new" }, { text: "to pay for", bold: true }]}
        body="Sign in with the coding plans you already have. Pick the right model for each task."
      />

      <Chapter
        id="automations"
        order={0}
        span={6}
        world="gold"
        still={still("armed")}
        alt="Three tickets land in a Doing column set to start agents; each shows an Implement countdown with a Cancel button."
        beats={[{ text: "Drag a ticket." }, { text: "Work starts.", bold: true }]}
        body="Save your instructions once. Drop a ticket in a column and an agent picks it up."
      />

      <Chapter
        id="limits"
        order={1}
        span={3}
        world="ember"
        still={still("limits")}
        alt="The usage limits popover: session and weekly windows with time left until they reset."
        beats={[{ text: "No surprise", bold: true }, { text: "usage limits." }]}
      />

      <Chapter
        id="mcp"
        order={2}
        span={3}
        world="cobalt"
        still={still("mcp")}
        alt="Settings, MCP servers: four servers, their tools, and their status."
        beats={[{ text: "Bring your tools", bold: true }, { text: "with MCP servers." }]}
      />

    </section>

    {/* What makes Volli different, said about Volli alone. */}
    <section class="why" aria-labelledby="why-title">
      <div class="why-head" data-reveal>
        <Super
          id="why-title"
          beats={[{ text: "Built for" }, { text: "twenty agents,", bold: true }, { text: "not one." }]}
        />
      </div>
      <ol class="why-list">
        {
          WHY.map((item, index) => (
            <li class="why-item" data-reveal style={`--stagger: ${index}`}>
              <span class="why-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <World
      as="section"
      world="ember"
      class="close"
      shader="mesh"
      focus={[0.5, 0.42]}
      aria-labelledby="close-title"
    >
      <div class="close-inner" data-reveal>
        <Mark size={132} build />
        <Super
          size="hero"
          id="close-title"
          beats={[{ text: "Start with" }, { text: "one ticket", bold: true }]}
          sub="Free for Apple silicon Macs. Open source."
        />
        <div class="close-actions">
          <a class="button" href="/download/">Download for Mac</a>
          <a class="link-quiet" href={DOCS_URL}>Read the docs <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </World>
  </main>

  <script>
    // The hero film: play the intro once, start the loop underneath it just
    // before it ends, then drop the intro. Nothing plays under reduced motion.
    const film = document.querySelector<HTMLElement>("[data-hero-film]");
    const intro = film?.querySelector<HTMLVideoElement>(".hero-intro");
    const loop = film?.querySelector<HTMLVideoElement>(".hero-loop");
    if (film && intro && loop && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      loop.preload = "auto";
      loop.load();
      intro.addEventListener("playing", () => film.setAttribute("data-playing", ""), { once: true });
      intro.addEventListener("ended", () => {
        void loop.play().then(() => film.setAttribute("data-looping", ""));
      });
      void intro.play().catch(() => film.setAttribute("data-still", ""));
    }
  </script>
</Base>
