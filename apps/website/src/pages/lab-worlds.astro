---
/**
 * TEMPORARY review page (VC-472): every world with each opt-in shader
 * background, so one can be picked. Not linked from anywhere; delete it (or
 * rename it `_lab-worlds.astro`) before shipping — it is otherwise built and
 * listed in the sitemap like any page.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

import cursorWide from "../assets/stills/cursor-wide.webp";
import islandWide from "../assets/stills/island-wide.webp";
import limitsWide from "../assets/stills/limits-wide.webp";
import mcpWide from "../assets/stills/mcp-wide.webp";
import modelsWide from "../assets/stills/models-wide.webp";
import splitWide from "../assets/stills/split-wide.webp";
import armedWide from "../assets/stills/armed-wide.webp";
import World from "../components/World.astro";
import type { WorldShaderVariant } from "../components/WorldShader";
import type { WorldName } from "../data/worlds";
import Base from "../layouts/Base.astro";

const WORLD_STILLS: ReadonlyArray<{ world: WorldName; still: ImageMetadata; line: string }> = [
  { world: "ember", still: mcpWide, line: "Add extra tools with MCP servers" },
  { world: "lagoon", still: armedWide, line: "Choose when agents start" },
  { world: "cobalt", still: islandWide, line: "Let agents help start the work" },
  { world: "aurora", still: cursorWide, line: "Share a browser with your agent" },
  { world: "rose", still: splitWide, line: "Put a terminal beside your chat" },
  { world: "gold", still: limitsWide, line: "See your usage limits" },
  { world: "lime", still: modelsWide, line: "Use subscriptions you already pay for" },
];

const VARIANTS: ReadonlyArray<{ id: WorldShaderVariant; name: string; note: string }> = [
  {
    id: "glsl",
    name: "A · glsl — Living canvas",
    note: "Hand-written WebGL, no dependency. The static world exactly, every pool drifting on its own minute-long orbit.",
  },
  {
    id: "mesh",
    name: "B · mesh — Paper MeshGradient",
    note: "Paper Shaders. The world's light and deep tones as wandering colour spots with a soft organic warp.",
  },
  {
    id: "grain",
    name: "C · grain — Paper GrainGradient",
    note: "Paper Shaders, “corners” shape. Colour gathers into the corners through a grainy, sand-like ramp.",
  },
];
---

<Base
  title="Worlds lab · Volli"
  description="Internal review: animated world backgrounds."
  path="/lab-worlds/"
>
  <main id="main" tabindex="-1" class="lab">
    <header class="lab-head">
      <h1>Worlds lab</h1>
      <p>
        Seven worlds × three shader backgrounds. Each fades in over today's static paint once
        its first frame is ready; only panels on screen animate. The still sits in variant A.
      </p>
      <button type="button" class="lab-toggle" aria-pressed="false">Show static (today)</button>
    </header>

    {
      WORLD_STILLS.map(({ world, still, line }) => (
        <section class="lab-world" aria-labelledby={`lab-${world}`}>
          <h2 id={`lab-${world}`}>{world}</h2>
          {VARIANTS.map((variant, index) => (
            <figure class="lab-figure">
              <World
                world={world}
                shader={variant.id}
                class="lab-panel"
                focus={[0.62, 0.55]}
                aria-label={`${world} — ${variant.name}`}
              >
                <p class="lab-line">{line}</p>
                {index === 0 && (
                  <Image
                    class="lab-still"
                    src={still}
                    alt=""
                    widths={[880, 1320]}
                    sizes="(max-width: 1100px) 80vw, 880px"
                  />
                )}
              </World>
              <figcaption>
                <strong>{variant.name}</strong> <span>{variant.note}</span>
              </figcaption>
            </figure>
          ))}
        </section>
      ))
    }
  </main>
</Base>

<script>
  const button = document.querySelector<HTMLButtonElement>(".lab-toggle");
  button?.addEventListener("click", () => {
    const on = document.documentElement.classList.toggle("lab-static");
    button.setAttribute("aria-pressed", String(on));
    button.textContent = on ? "Show shaders" : "Show static (today)";
  });
</script>

<style is:global>
  .lab {
    display: flex;
    flex-direction: column;
    gap: 72px;
    padding: 48px 24px 120px;
    align-items: center;
  }

  .lab-head {
    width: min(1100px, 100%);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .lab-head h1 {
    font-size: 40px;
  }

  .lab-head p {
    max-width: 70ch;
    opacity: 0.7;
  }

  .lab-toggle {
    align-self: flex-start;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.2);
    background: rgb(255 255 255 / 0.06);
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .lab-static .world-shader {
    opacity: 0 !important;
  }

  .lab-world {
    width: min(1100px, 100%);
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .lab-world h2 {
    font-size: 28px;
    text-transform: capitalize;
  }

  .lab-figure {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .lab-panel {
    width: 100%;
    aspect-ratio: 1100 / 620;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 44px 48px 0;
    gap: 28px;
  }

  .lab-line {
    align-self: flex-start;
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
    line-height: 1.05;
  }

  .lab-still {
    width: 80%;
    height: auto;
  }

  .lab-figure figcaption {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    font-size: 14px;
  }

  .lab-figure figcaption span {
    opacity: 0.65;
  }
</style>
