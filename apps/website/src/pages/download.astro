---
import "@fontsource-variable/mona-sans/wght.css";
import "../styles/global.css";

const repositoryUrl = "https://github.com/hussainph/volli-code";
const releasesUrl = `${repositoryUrl}/releases`;
const issuesUrl = `${repositoryUrl}/issues`;
const docsUrl = "https://docs.volli.app";
const description =
  "Download the Volli Code alpha for Apple silicon Macs — one build, served straight from GitHub Releases.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href="https://volli.app/download/" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://volli.app/download/" />
    <meta property="og:title" content="Download Volli Code — alpha for Apple silicon" />
    <meta property="og:description" content={description} />
    {/* Same card as the homepage: a shared download link should still look like
        Volli, and the card is about the product, not the page. */}
    <meta property="og:image" content="https://volli.app/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Volli Code — the workspace for parallel coding agents" />
    <meta property="og:site_name" content="Volli Code" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Download Volli Code — alpha for Apple silicon" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://volli.app/og.png" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/png" href="/volli-icon-dark.png" />
    <title>Download Volli Code — alpha for Apple silicon</title>
    <noscript>
      <style>
        [data-live] {
          display: none;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#download">Skip to download</a>
    <main class="download-main">
      <header class="download-topbar">
        <a class="footer-brand download-brand" href="/" aria-label="Volli home">
          <img src="/volli-icon-dark.png" alt="" width="34" height="34" />
          <span>Volli</span>
        </a>
        <nav aria-label="Site">
          <a href={docsUrl}>Docs</a>
          <a href={repositoryUrl}>GitHub</a>
        </nav>
      </header>

      <section class="download-intro" id="download">
        <span class="alpha-pill">Alpha</span>
        <h1>Download Volli Code</h1>
        <p class="download-sub">
          One build, for Apple silicon Macs (M1 and later), served straight from <a
            href={releasesUrl}>GitHub Releases</a
          >. This is an early alpha: expect rough edges and changes between builds. Prefer to build
          it yourself? Follow the <a href={`${docsUrl}/start/install/`}>install guide</a>.
        </p>
        <p class="platform-note" data-platform-note hidden>
          Volli Code runs on macOS only, and this build is Apple silicon only — there is no Intel or
          Windows build today.
        </p>
      </section>

      <section class="channel-grid" aria-label="Alpha build">
        <article class="channel-card channel-card--alpha" data-channel="alpha">
          <header class="channel-head">
            <h2>Alpha</h2>
            <span class="channel-badge" data-prerelease-badge>Prerelease</span>
          </header>
          <p class="channel-tagline">
            The current build. Apple silicon, signed and notarized, and it updates itself when a
            newer alpha ships.
          </p>
          <div class="channel-body" data-slot="body">
            <p class="channel-status" data-live>Checking the latest build…</p>
            <p class="channel-status"><a href={releasesUrl}>Browse releases on GitHub</a></p>
          </div>
        </article>
      </section>

      <section class="alpha-terms" aria-labelledby="alpha-terms-heading">
        <h2 id="alpha-terms-heading">What you're signing up for</h2>
        <dl>
          <div>
            <dt>Supported Macs</dt>
            <dd>
              Apple silicon (M1 and later) on macOS. There is no Intel or universal build yet.
            </dd>
          </div>
          <div>
            <dt>Stability</dt>
            <dd>
              Alpha. Features move, and a build can change behavior you were relying on. Don't point
              it at work you can't afford to lose track of.
            </dd>
          </div>
          <div>
            <dt>Updates</dt>
            <dd>
              The app checks GitHub Releases, downloads a newer alpha in the background, and installs
              it when you quit.
            </dd>
          </div>
          <div>
            <dt>Your data</dt>
            <dd>
              Projects, tickets, chat history, and worktrees stay on your Mac. Model requests go to
              the provider you pick in Model Access. <a href={`${docsUrl}/start/install/`}
                >Where it all lives</a
              >.
            </dd>
          </div>
          <div>
            <dt>Feedback and bugs</dt>
            <dd>
              Open a <a href={issuesUrl}>GitHub issue</a>. For anything security-related, use <a
                href={`${repositoryUrl}/security/advisories/new`}>private vulnerability reporting</a
              > instead.
            </dd>
          </div>
        </dl>
      </section>

      <p class="download-all-releases">
        Every build, including earlier canaries and their notes, lives on <a href={releasesUrl}
          >GitHub Releases</a
        >.
      </p>
    </main>

    <footer>
      <a class="footer-brand" href="/" aria-label="Volli home">
        <img src="/volli-icon-dark.png" alt="" width="34" height="34" />
        <span>Volli</span>
      </a>
      <nav aria-label="Footer">
        <a href="/download/">Download</a>
        <a href={docsUrl}>Docs</a>
        <a href={`${docsUrl}/start/quickstart/`}>Quickstart</a>
        <a href={repositoryUrl}>GitHub</a>
        <a href={releasesUrl}>Releases</a>
        <a href={`${repositoryUrl}/security/policy`}>Security</a>
        <a href={issuesUrl}>Feedback</a>
      </nav>
    </footer>

    <script>
      import {
        formatBytes,
        formatPublishedDate,
        isMacPlatform,
        primaryArtifact,
        resolveAlphaBuild,
        type AlphaBuild,
        type Release,
      } from "../lib/releases";

      const RELEASES_API = "https://api.github.com/repos/hussainph/volli-code/releases?per_page=20";
      const RELEASES_URL = "https://github.com/hussainph/volli-code/releases";

      function el<K extends keyof HTMLElementTagNameMap>(
        tag: K,
        className: string,
        text?: string,
      ): HTMLElementTagNameMap[K] {
        const node = document.createElement(tag);
        node.className = className;
        if (text !== undefined) node.textContent = text;
        return node;
      }

      function statusLine(text: string, linkLabel: string, linkHref: string): HTMLElement[] {
        const status = el("p", "channel-status", text);
        const linkLine = el("p", "channel-status");
        const link = el("a", "", linkLabel);
        link.href = linkHref;
        linkLine.append(link);
        return [status, linkLine];
      }

      function buildNodes(build: AlphaBuild): HTMLElement[] {
        const nodes: HTMLElement[] = [];

        const meta = el("p", "channel-version");
        meta.append(el("span", "channel-version-number", `v${build.version}`));
        const published = formatPublishedDate(build.publishedAt);
        if (published) meta.append(el("span", "channel-version-date", published));
        nodes.push(meta);

        // One primary press. Every other artifact stays reachable, but only the
        // dmg gets the ember treatment — two primaries is no recommendation.
        const primary = primaryArtifact(build);
        const list = el("div", "artifact-list");
        for (const artifact of build.artifacts) {
          const isPrimary = artifact === primary;
          const row = el("a", isPrimary ? "artifact artifact--primary" : "artifact");
          row.href = artifact.url;
          const label =
            artifact.kind === "dmg"
              ? `Download for ${artifact.arch ?? "macOS"}`
              : `${artifact.arch ?? "macOS"} .zip archive`;
          row.append(el("span", "artifact-label", label));
          row.append(
            el("span", "artifact-meta", `.${artifact.kind} · ${formatBytes(artifact.sizeBytes)}`),
          );
          list.append(row);
        }
        nodes.push(list);

        const notes = el("p", "channel-status");
        const notesLink = el("a", "", "Release notes");
        notesLink.href = build.releaseUrl;
        notes.append(notesLink);
        nodes.push(notes);

        return nodes;
      }

      function render(nodes: HTMLElement[]): void {
        const body = document.querySelector('[data-channel="alpha"] [data-slot="body"]');
        if (!body) return;
        body.replaceChildren(...nodes);
      }

      async function load(): Promise<void> {
        let releases: Release[];
        try {
          const response = await fetch(RELEASES_API, {
            headers: { accept: "application/vnd.github+json" },
          });
          if (!response.ok) throw new Error(`GitHub API responded ${response.status}`);
          releases = (await response.json()) as Release[];
        } catch {
          // Rate limit (60 req/hr unauthenticated) or offline — keep a
          // working path to the same builds instead of a dead end.
          render(
            statusLine("Couldn't reach GitHub just now.", "Get it from GitHub Releases", RELEASES_URL),
          );
          return;
        }

        const build = resolveAlphaBuild(releases);
        if (!build) {
          render(
            statusLine("No build published right now.", "Browse releases on GitHub", RELEASES_URL),
          );
          return;
        }

        // The badge states what GitHub says, rather than assuming: a promoted
        // stable tag must not keep wearing "Prerelease".
        if (!build.prerelease) {
          document.querySelector("[data-prerelease-badge]")?.remove();
        }
        render(buildNodes(build));
      }

      if (!isMacPlatform(navigator.userAgent, navigator.platform)) {
        document.querySelector("[data-platform-note]")?.removeAttribute("hidden");
      }

      void load();
    </script>
  </body>
</html>
