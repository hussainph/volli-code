---
/**
 * volli.app/download (BRAND.md §9): one world, the build, and the terms.
 *
 * The build is resolved live from GitHub Releases by `src/lib/releases.ts`, so
 * a new release needs no edit here (VC-62).
 */
import Mark from "../components/Mark.astro";
import Super from "../components/Super.astro";
import World from "../components/World.astro";
import { DOCS_URL, ISSUES_URL, RELEASES_URL, REPOSITORY_URL } from "../data/links";
import Base from "../layouts/Base.astro";

const description =
  "Download Volli for Apple silicon Macs — free and open source, served straight from GitHub Releases.";
---

<Base
  title="Download Volli for Apple silicon Macs"
  description={description}
  path="/download/"
  skipTo="#download"
>
  <noscript slot="head">
    <style>
      [data-live] {
        display: none;
      }
    </style>
  </noscript>

  <main id="main" tabindex="-1">
    <World as="section" world="ember" class="dl" focus={[0.72, 0.36]} id="download" aria-labelledby="download-title">
      <div class="dl-inner">
        <Super
          size="hero"
          level={1}
          id="download-title"
          beats={[{ text: "Download" }, { text: "Volli.", bold: true }]}
          sub="Free for Apple silicon Macs."
        />
        <div class="dl-build" data-slot="build">
          <p class="dl-status" data-live>Checking the latest build…</p>
          <p class="dl-status"><a href={RELEASES_URL}>Browse releases on GitHub →</a></p>
        </div>
        <p class="dl-platform" data-platform-note hidden>
          Volli runs on Apple silicon Macs.
        </p>
      </div>
      <div class="dl-mark" data-reveal aria-hidden="true">
        <Mark size={240} build />
      </div>
    </World>

    <section class="terms" aria-labelledby="terms-title">
      <h2 id="terms-title">Before you install</h2>
      <dl>
        <div>
          <dt>Macs</dt>
          <dd>Apple silicon, M1 or later, on macOS 12 Monterey or later.</dd>
        </div>
        <div>
          <dt>Updates</dt>
          <dd>New builds download in the background and install when you quit.</dd>
        </div>
        <div>
          <dt>Your data</dt>
          <dd>
            Your projects, tickets and chats stay on your Mac. Model requests go only to the
            provider you sign in to. <a href={`${DOCS_URL}/start/install/`}>Where it all lives</a>.
          </dd>
        </div>
        <div>
          <dt>Build it yourself</dt>
          <dd>
            Get the source on <a href={REPOSITORY_URL}>GitHub</a> and follow the <a
              href={`${DOCS_URL}/start/install/`}>install guide</a
            >.
          </dd>
        </div>
        <div>
          <dt>Problems</dt>
          <dd>
            Open a <a href={ISSUES_URL}>GitHub issue</a>. Report security issues <a
              href={`${REPOSITORY_URL}/security/advisories/new`}>privately</a
            >.
          </dd>
        </div>
      </dl>
    </section>
  </main>

  <script>
        import {
          formatBytes,
          formatPublishedDate,
          isMacPlatform,
          primaryArtifact,
          resolveAlphaBuild,
          type AlphaBuild,
          type Release,
        } from "../lib/releases";
  
        const RELEASES_API = "https://api.github.com/repos/hussainph/volli-code/releases?per_page=20";
        const RELEASES_URL = "https://github.com/hussainph/volli-code/releases";
  
        function el<K extends keyof HTMLElementTagNameMap>(
          tag: K,
          className: string,
          text?: string,
        ): HTMLElementTagNameMap[K] {
          const node = document.createElement(tag);
          node.className = className;
          if (text !== undefined) node.textContent = text;
          return node;
        }
  
        function statusLine(text: string, linkLabel: string, linkHref: string): HTMLElement[] {
          const status = el("p", "dl-status", text);
          const linkLine = el("p", "dl-status");
          const link = el("a", "", linkLabel);
          link.href = linkHref;
          linkLine.append(link);
          return [status, linkLine];
        }
  
        function buildNodes(build: AlphaBuild): HTMLElement[] {
          const nodes: HTMLElement[] = [];
  
          const meta = el("p", "dl-version");
          meta.append(el("span", "", `v${build.version}`));
          const published = formatPublishedDate(build.publishedAt);
          if (published) meta.append(el("span", "", published));
          if (build.prerelease) meta.append(el("span", "", "Prerelease"));
          nodes.push(meta);
  
          // One primary press. Every other artifact stays reachable, but only the
          // dmg gets the ember treatment — two primaries is no recommendation.
          const primary = primaryArtifact(build);
          const list = el("div", "dl-artifacts");
          for (const artifact of build.artifacts) {
            const isPrimary = artifact === primary;
            const row = el("a", isPrimary ? "button" : "link-quiet");
            row.href = artifact.url;
            const label =
              artifact.kind === "dmg"
                ? `Download for ${artifact.arch ?? "Mac"}`
                : `${artifact.arch ?? "macOS"} .zip`;
            row.append(el("span", "", label));
            row.append(
              el("span", "dl-meta", `.${artifact.kind} · ${formatBytes(artifact.sizeBytes)}`),
            );
            list.append(row);
          }
          nodes.push(list);
  
          const notes = el("p", "dl-status");
          const notesLink = el("a", "", "Release notes →");
          notesLink.href = build.releaseUrl;
          notes.append(notesLink);
          nodes.push(notes);
  
          return nodes;
        }
  
        function render(nodes: HTMLElement[]): void {
          const body = document.querySelector('[data-slot="build"]');
          if (!body) return;
          body.replaceChildren(...nodes);
        }
  
        async function load(): Promise<void> {
          let releases: Release[];
          try {
            const response = await fetch(RELEASES_API, {
              headers: { accept: "application/vnd.github+json" },
            });
            if (!response.ok) throw new Error(`GitHub API responded ${response.status}`);
            releases = (await response.json()) as Release[];
          } catch {
            // Rate limit (60 req/hr unauthenticated) or offline — keep a
            // working path to the same builds instead of a dead end.
            render(
              statusLine("Couldn't reach GitHub just now.", "Get it from GitHub Releases", RELEASES_URL),
            );
            return;
          }
  
          const build = resolveAlphaBuild(releases);
          if (!build) {
            render(
              statusLine("No build published right now.", "Browse releases on GitHub", RELEASES_URL),
            );
            return;
          }
  
          // The version line states what GitHub says, rather than assuming: a
          // promoted stable tag must not keep wearing "Prerelease".
          render(buildNodes(build));
        }
  
        if (!isMacPlatform(navigator.userAgent, navigator.platform)) {
          document.querySelector("[data-platform-note]")?.removeAttribute("hidden");
        }
  
        void load();
      </script>
</Base>
