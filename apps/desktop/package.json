{
  "name": "@volli/desktop",
  "version": "0.1.0-canary.7",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "postinstall": "pnpm run rebuild:native && pnpm run cache:node-sqlite",
    "cache:node-sqlite": "node scripts/cache-node-sqlite.mjs",
    "check:theme-css": "node scripts/generate-theme-css.mjs --check",
    "check:design-tokens": "node scripts/check-design-tokens.mjs --self-test && node scripts/check-design-tokens.mjs",
    "check:node-version": "node scripts/check-node-version.mjs --self-test && node scripts/check-node-version.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vp test run",
    "start": "node scripts/start-electron.mjs",
    "ensure:electron": "node -e \"console.log(require('electron'))\"",
    "test:coverage": "vp test run --coverage",
    "rebuild:native": "electron-rebuild -f -w node-pty,better-sqlite3",
    "dist": "vp run build && electron-builder"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@lezer/markdown": "^1.7.2",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@shikijs/langs": "4.3.1",
    "@shikijs/monaco": "4.3.1",
    "@shikijs/themes": "4.3.1",
    "@shikijs/vscode-textmate": "10.0.2",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/mermaid": "^1.0.2",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@volli/agent-runtime": "workspace:*",
    "@volli/session-engine": "workspace:*",
    "@volli/session-rpc": "workspace:*",
    "@volli/shared": "workspace:*",
    "ai": "^7.0.60",
    "better-sqlite3": "^12.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.13",
    "electron-updater": "^6.8.9",
    "jsdom": "^30.0.1",
    "marked": "^18.0.9",
    "monaco-editor": "^0.56.0",
    "motion": "^12.43.0",
    "nanoid": "^6.0.1",
    "node-pty": "1.1.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "restty": "^0.2.0",
    "shiki": "4.3.1",
    "sonner": "^2.0.8",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "use-stick-to-bottom": "^1.1.6",
    "yaml": "2.9.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.5",
    "apca-w3": "^0.1.9",
    "electron": "^43.4.0",
    "electron-builder": "26.15.3",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "productName": "Volli Code"
}
