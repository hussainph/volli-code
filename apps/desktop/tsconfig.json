{
  "files": [],
  "references": [{ "path": "./tsconfig.node.json" }, { "path": "./tsconfig.web.json" }],
  // compilerOptions exist ONLY for the shadcn CLI. It resolves @renderer/*
  // through tsconfig `paths` (tsconfig-paths), which does not follow
  // `references` — so the mapping is duplicated here, in the solution file it
  // actually reads; components.json `aliases` alone will not resolve it. With
  // no baseUrl (TS 7 removed the option) tsconfig-paths resolves `paths`
  // against this file's own directory, which is what `baseUrl: "."` meant
  // here — dropping it was a no-op for shadcn, verified with an
  // `npx shadcn add --dry-run`. tsc validates these options but never applies
  // them (`files: []` — zero inputs); the desktop `typecheck` script parses
  // this file first for exactly that reason: that clause checks no code and
  // exists only to fail on an option this TypeScript rejects.
  // tsconfig.web.json stays the real authority for @renderer/* at
  // type-check time.
  "compilerOptions": {
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"]
    }
  }
}
