{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "types": ["node"],
    // vite.config.ts imports the plain-JS dev-constants module (it must stay
    // .mjs — scripts/dev.mjs runs under plain node, so a .ts file won't do).
    "allowJs": true,
    // The read-only storage tools load their source modules directly under
    // Node's type stripper, where explicit `.ts` is required by ESM.
    "allowImportingTsExtensions": true,
    // The real-link Sessions test (src/main/remote-sessions.real-link.test.ts)
    // drives the renderer's remote-Session binding and stores, which import
    // through the renderer's alias.
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"]
    },
    // ...and some of what those import is a renderer .tsx module.
    "jsx": "react-jsx"
  },
  // src/ipc is the shared type-only IPC contract — all three processes read it.
  "include": [
    "src/ipc/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "vite.config.ts",
    "scripts/dev-constants.mjs"
  ]
}
