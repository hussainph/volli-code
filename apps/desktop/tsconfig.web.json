{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"]
    }
  },
  // The UI lab (src/renderer/lab) is dev-server-only and never built, but it
  // IS type-checked: it imports real app components, so a signature change in
  // the app should break the lab here rather than at `pnpm lab`.
  // src/ipc is the shared type-only IPC contract — all three processes read it.
  "include": [
    "src/ipc/**/*",
    "src/renderer/src/**/*",
    "src/renderer/lab/**/*",
    "src/preload/*.d.ts"
  ]
}
