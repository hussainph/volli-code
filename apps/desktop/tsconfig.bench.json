  // main-process config never carries bench files.
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "composite": false
  },
  "include": ["e2e/bench/mcp-parallel/**/*.ts", "vite.mcp-parallel-bench.config.ts"]
}
