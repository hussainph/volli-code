---
/*
 * Page title, plus a "Copy page" control.
 *
 * Borrowed from cursor.com/docs, which puts a copy affordance next to every
 * title. People paste our pages into the agents they run, and a page copied
 * out of the DOM arrives as soup: the sidebar, the contents rail, and the
 * heading anchors all come with it. This copies the page's Markdown source
 * instead, served by src/pages/[...slug].md.ts.
 *
 * The button only appears once its script has run, so a visitor without
 * JavaScript never sees a control that can't work.
 */
// Starlight's own PAGE_TITLE_ID. Its constants module isn't a public export,
// and the value is the skip-link target, so it has to stay in step by hand.
const PAGE_TITLE_ID = "_top";

const { entry, id } = Astro.locals.starlightRoute;
// The home page's id is the empty string, which would address `/.md`.
const slug = id.replace(/\/$/, "") || "index";
const source = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${slug}.md`;
---

<div class="title-row">
  <h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
  <copy-page data-source={source}>
    <button type="button" hidden>
      <span data-label>Copy page</span>
    </button>
  </copy-page>
</div>

<script>
  class CopyPage extends HTMLElement {
    constructor() {
      super();
      const button = this.querySelector("button");
      const label = this.querySelector("[data-label]");
      const source = this.dataset.source;
      if (!button || !label || !source || !navigator.clipboard) return;

      button.hidden = false;

      let resetTimer: ReturnType<typeof setTimeout> | undefined;
      const say = (text: string) => {
        label.textContent = text;
        clearTimeout(resetTimer);
        resetTimer = setTimeout(() => {
          label.textContent = "Copy page";
        }, 2000);
      };

      button.addEventListener("click", async () => {
        try {
          const response = await fetch(source);
          if (!response.ok) throw new Error(String(response.status));
          await navigator.clipboard.writeText(await response.text());
          say("Copied");
        } catch {
          say("Copy failed");
        }
      });
    }
  }
  customElements.define("copy-page", CopyPage);
</script>

<style>
  .title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  /* The website's heading voice (BRAND.md §5): Mona Sans set heavy, a touch
     wide, and tightly tracked. */
  h1 {
    color: var(--volli-ink);
    font-size: var(--sl-text-h1);
    font-weight: 700;
    font-stretch: 106%;
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  /* The website's quiet button, small: glass on the page, never a second
     colour. */
  button {
    display: inline-flex;
    flex-shrink: 0;
    min-height: 32px;
    margin-top: 0.35rem;
    padding: 0 14px;
    align-items: center;
    border: 0;
    border-radius: 999px;
    background: var(--volli-glass);
    box-shadow: 0 0 0 1px var(--volli-hairline-strong) inset;
    color: var(--volli-ink-2);
    font: inherit;
    font-size: 13px;
    font-weight: 520;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  button:hover {
    background: var(--volli-glass-strong);
    color: var(--volli-ink);
  }

  @media (max-width: 36rem) {
    .title-row {
      flex-direction: column;
      gap: 0.875rem;
    }

    button {
      margin-top: 0;
    }
  }

  @media print {
    button {
      display: none;
    }
  }
</style>
