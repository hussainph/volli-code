{
  "name": "@volli/docs",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build && pnpm run check:docs && pnpm run licenses:check",
    "check:docs": "node scripts/check-docs.mjs --self-test && node scripts/check-docs.mjs",
    "licenses:check": "check-font-notices .",
    "deploy": "pnpm run build && wrangler pages deploy dist --project-name volli-docs --branch main",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.5",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@volli/font-notices": "workspace:*",
    "@volli/shared": "workspace:*",
    "astro": "7.3.5",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.4",
    "typescript": "6.0.3",
    "wrangler": "4.147.0"
  }
}
