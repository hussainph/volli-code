{
  "name": "volli-code",
  "version": "0.0.1",
  "private": true,
  "description": "A local-first macOS workspace for tickets, coding sessions, worktrees, and review.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "dev": "vp run --filter @volli/desktop dev",
    "lab": "vp run --filter @volli/desktop lab",
    "build": "vp run --filter @volli/desktop build",
    "start": "vp run --filter @volli/desktop start",
    "ensure:electron": "vp run --filter @volli/desktop ensure:electron",
    "typecheck": "tsc --noEmit -p tsconfig.json && vp run -r typecheck",
    "test": "vp run -r test",
    "test:coverage": "vp run -r test:coverage",
    "smoke:pi": "pnpm run build && node apps/desktop/e2e/pi-ticket-chat-smoke.mjs && node apps/desktop/e2e/pi-scratch-chat-smoke.mjs && node apps/desktop/e2e/pi-sessions-host-smoke.mjs",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^24.13.0"
  },
  "packageManager": "pnpm@11.10.0"
}
