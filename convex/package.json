{
  "name": "@volli/convex",
  "version": "0.0.1",
  "private": true,
  "description": "The Volli Cloud backend: Convex schema and server functions, plus the pinned local-backend test fixture.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./api": {
      "types": "./functions/_generated/api.d.ts",
      "import": "./functions/_generated/api.js"
    }
  },
  "scripts": {
    "backend:fetch": "node fixture/fetch-backend.ts",
    "codegen": "node fixture/with-backend.ts -- convex codegen --typecheck disable",
    "deploy:checked": "node scripts/deploy.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:backend": "vp test run --config vite.backend.config.ts",
    "test:matrix": "vp test run --config vite.matrix.config.ts",
    "with-backend": "node fixture/with-backend.ts"
  },
  "dependencies": {
    "@volli/shared": "workspace:*",
    "convex": "1.48.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@volli/host-core": "workspace:*",
    "@volli/session-engine": "workspace:*",
    "convex-test": "0.0.65",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
