    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "smoke": "vp test run --config vite.smoke.config.ts",
    "bench": "vp test run --config vite.bench.config.ts",
    "bench:runtime": "vp test run --config vite.bench.config.ts bench/parallel-tools/runtime-cost.bench.test.ts",
