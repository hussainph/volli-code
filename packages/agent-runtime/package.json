    "bench:runtime:profile": "node bench/parallel-tools/run-profile.mjs",
    "bench:turn-to-completion": "node bench/turn-to-completion/run.mjs",
    "bench:reduction": "vp test run --config vite.bench.config.ts bench/read-only-reduction/read-only-reduction.bench.test.ts",
    "bench:live": "vp test run --config vite.bench-live.config.ts",
    "bench:probe": "node --experimental-strip-types bench/parallel-tools/probe.ts"
  },
